{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "God Hand: Rearmed",
  "repo": "God-Hand-Rearmed/God-Hand-Rearmed",
  "game": {
    "kind": "iso",
    "label": "Your disc image (.iso) of God Hand for PlayStation 2, the USA release (serial SLUS-21503).",
    "check": {
      "iso9660": "SLUS_215.03"
    },
    "dumps": [
      {
        "name": "USA",
        "size": 1567686656,
        "crc32": "07220ad2"
      }
    ]
  },
  "start": {
    "program": [
      "GHR.exe"
    ],
    "args": []
  },
  "prepare": {
    "program": [
      "GHR.exe"
    ],
    "args": [
      "--prepare",
      "--iso",
      "{game}"
    ],
    "label": "Checking your disc and writing the default settings",
    "timeout": 120
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{install}/GHR.ini"
        }
      ],
      "game_path": "Game/Iso"
    }
  ],
  "saves": [
    "{install}/memcards",
    "{install}/GHR.ini",
    "{install}/controls.ini"
  ],
  "folders": {
    "saves": [
      {
        "path": "{install}/memcards"
      }
    ],
    "states": [
      {
        "path": "{install}/states"
      }
    ],
    "logs": [
      {
        "path": "{install}/logs"
      }
    ]
  },
  "actions": [
    {
      "id": "saves",
      "label": "Memory card",
      "help": "Your saved games.",
      "open": "saves"
    },
    {
      "id": "states",
      "label": "Save states",
      "help": "The save states you made in game.",
      "open": "states"
    },
    {
      "id": "logs",
      "label": "Logs",
      "help": "What to attach to a bug report.",
      "open": "logs"
    }
  ],
  "exit_codes": {
    "2": "No disc image was given. Pick your copy of God Hand again on the game's page.",
    "3": "That disc image isn't the USA release of God Hand (SLUS-21503), the one God Hand: Rearmed is built from. Pick that one on the game's page.",
    "4": "Your processor is too old for God Hand: Rearmed (it needs SSE4.1)."
  },
  "looks": {
    "allowed": false,
    "reason": "God Hand: Rearmed has its own picture options (Anti-Aliasing, Texture Filtering, Post Effects)."
  },
